# Required: get a free API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq model used for answer generation (must support tool calling)
# Check currently available models at https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Local embedding model (sentence-transformers, downloaded on first use)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Where source documents live
DOC_DIRECTORY=doc

# ChromaDB persistence
CHROMA_PERSIST_DIRECTORY=chroma_db
CHROMA_COLLECTION_NAME=documents

# Text splitting
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Number of chunks retrieved per query
RETRIEVAL_K=4
