# Required: get a free API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq model used for answer generation (must support tool calling)
# Check currently available models at https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Local embedding model (sentence-transformers, downloaded on first use)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Where source documents live
DOC_DIRECTORY=doc

# ChromaDB persistence
CHROMA_PERSIST_DIRECTORY=chroma_db
CHROMA_COLLECTION_NAME=documents

# Text splitting
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Number of chunks retrieved per query
RETRIEVAL_K=4

# Where per-user conversation history is persisted (LangGraph checkpointer)
CHECKPOINT_DB_PATH=checkpoints.sqlite

# Context management: bound token growth on long conversations instead of
# replaying the full history (including every past retrieved chunk) each turn.
# 1) Clear old tool outputs (retrieved chunks) once approx. token count in the
#    conversation exceeds this, keeping the N most recent tool outputs intact.
CONTEXT_EDIT_TRIGGER_TOKENS=4000
CONTEXT_EDIT_KEEP_TOOL_OUTPUTS=3
# 2) If history is still large after that, summarize older messages into one
#    condensed message, keeping the N most recent messages verbatim.
SUMMARIZATION_TRIGGER_TOKENS=6000
SUMMARIZATION_KEEP_MESSAGES=12

# Optional: LangSmith tracing (https://smith.langchain.com). When enabled,
# every agent run (tool calls, retrieved chunks, prompts, latency, token
# usage) is sent to LangSmith for inspection/debugging. Off by default -
# nothing is sent unless LANGSMITH_TRACING=true. Get a free API key at
# https://smith.langchain.com/settings.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=document-qa-agent
